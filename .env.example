PORT=3000
HOST=0.0.0.0
# Unset locally → the server prints a one-time dev password.
# Required (10+ chars) when NODE_ENV=production.
# ADMIN_PASSWORD=
DATA_FILE=./data/products.json

# Production only. When set, www.<host> issues a single 301 to the bare
# domain so the site is never indexed under two addresses.
# Leave this unset locally.
# CANONICAL_HOST=tacey.odhis.co.ke
